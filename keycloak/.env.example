# Copy this file to `keycloak/.env` and replace the placeholder secrets.
# `keycloak/.env` is gitignored.

# Keycloak admin console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8085

# Postgres database backing Keycloak
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=password
POSTGRES_PORT=5435
