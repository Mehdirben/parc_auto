# Copy this file to `.env` in the project root and adjust as needed.
# `.env` itself is gitignored.

# Frontend
FRONTEND_PORT=4205

# Spring Boot API
BACKEND_PORT=8080

# SQL Server Developer edition
SQLSERVER_PORT=1433
# SQL Server requires a strong password (upper/lowercase, number, symbol).
MSSQL_SA_PASSWORD=ChangeMe_Strong!2026

# Host port used by the Keycloak compose stack.
KEYCLOAK_PORT=8085
