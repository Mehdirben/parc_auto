# Copy this file to `.env` in the project root and adjust as needed.
# `.env` itself is gitignored. This file configures the main application stack;
# Keycloak admin and Postgres settings belong in `keycloak/.env` (see
# `keycloak/.env.example`).

# Frontend
FRONTEND_PORT=4205

# Spring Boot API
BACKEND_PORT=8080
# Set to true to load the idempotent local demo dataset at backend startup.
MOCK_DATA_ENABLED=false

# SQL Server Developer edition
SQLSERVER_PORT=1433
# SQL Server requires a strong password (upper/lowercase, number, symbol).
MSSQL_SA_PASSWORD=ChangeMe_Strong!2026

# Host port used by the Keycloak compose stack.
# Keep it identical to KEYCLOAK_PORT in keycloak/.env.
KEYCLOAK_PORT=8085
